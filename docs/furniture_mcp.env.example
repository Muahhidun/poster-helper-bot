# Synthetic placeholders only. Nothing loads this file automatically.
# Keep disabled until a separate approved activation.
FURNITURE_MCP_ENABLED=false
FURNITURE_MCP_AUTH0_ISSUER=https://tenant.example.invalid/
FURNITURE_MCP_RESOURCE_URL=https://archive.example.invalid/mcp
FURNITURE_MCP_AUTH0_CLIENT_ID=replace-with-registered-client-id
FURNITURE_MCP_OWNER_SUB='auth0|replace-with-owner-sub'
FURNITURE_MCP_CHAT_IDS=approved-furniture-group@g.us
FURNITURE_CHAT_IDS=approved-furniture-group@g.us
FURNITURE_READ_CHAT_IDS=approved-furniture-group@g.us
FURNITURE_INSTANCE_ID=replace-with-approved-instance
FURNITURE_STORAGE_DIR=/absolute/private/archive
# On the webhook worker only, when adding a NEW furniture-only Railway volume:
# FURNITURE_VOLUME_MOUNT_PATH=/furniture-data
# FURNITURE_STORAGE_DIR=/furniture-data/archive
# Deploy the config.py path guard BEFORE attaching this volume. Without it,
# Railway's automatic mount variable would relocate accounting data paths.
FURNITURE_MCP_MIN_ISSUED_AT=0
# Default: local read-only SQLite archive in this process's private directory.
FURNITURE_MCP_ARCHIVE_BACKEND=sqlite
# Alternative for a separate MCP service (never a GREEN-API or OAuth token):
# FURNITURE_MCP_ARCHIVE_BACKEND=http
# FURNITURE_MCP_ARCHIVE_URL=https://source.example.invalid/api/furniture-reader/mcp
# FURNITURE_MCP_ARCHIVE_TOKEN=enter-a-separate-random-read-token-in-protected-settings
# HTTP mode does not use or inspect FURNITURE_STORAGE_DIR.
